{
  "schemaVersion": 1,
  "id": "fixordium",
  "version": "${version}",
  "name": "Fixordium",
  "description": "A lightweight client-side rendering optimization mod for Fabric and Sodium.",
  "authors": ["fixpot47"],
  "contact": {
    "sources": "https://github.com/fixpot47/fixordium"
  },
  "license": "MIT",
  "icon": "assets/fixordium/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.fixpot47.fixordium.FixordiumClient"
    ],
    "sodium:config_api_user": [
      "dev.fixpot47.fixordium.FixordiumSodiumConfig"
    ]
  },
  "mixins": [
    {
      "config": "fixordium.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": ">=0.152.2",
    "sodium": ">=0.9.1",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
